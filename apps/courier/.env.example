# Copy to apps/courier/.env (gitignored). Photon credentials go here and nowhere else.

# Photon dashboard → project Settings. Leave empty to print texts to the terminal instead of sending them.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# B's Convex dev deployment. Leave empty to run against the local stub on STUB_PORT.
CONVEX_URL=
# Shared secret the messages.* courier functions check. Must match the Convex env var of the same name.
COURIER_KEY=

STUB_PORT=3210

# Web dashboard base URL for links in texts, e.g. the Vercel URL. Leave empty and links render as
# "[DASHBOARD_URL not set]/c/a/manager" so the text still reads as unfinished.
DASHBOARD_URL=
