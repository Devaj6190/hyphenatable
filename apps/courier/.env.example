# Copy to apps/courier/.env (gitignored). Photon credentials go here and nowhere else.

# Photon dashboard → project Settings. Leave empty to print texts to the terminal instead of sending them.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# B's Convex dev deployment. Leave empty to run against the local stub on STUB_PORT.
CONVEX_URL=
# Shared secret the messages.* courier functions check. Must match the Convex env var of the same name.
COURIER_KEY=

STUB_PORT=3210

# Web dashboard base URL for links in texts, e.g. the Vercel URL. Leave empty and the manager's summary
# leaves out its "Details here" line; no placeholder is ever sent.
DASHBOARD_URL=

# First name the manager's summary greets ("Hi ..."). Leave empty to use the fixture's fake name. Real names
# go in .env only, never in a committed file.
MANAGER_DISPLAY_NAME=
