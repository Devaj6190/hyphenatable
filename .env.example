# Copy to .env (never commit). Server-side keys also go in Convex: bunx convex env set NAME value
NEXT_PUBLIC_CONVEX_URL=
# Optional fallback for the live dashboard. It looks the company, owner and manager up from Convex by role (roster.list);
# set these only if that lookup is not deployed. Row ids change if the database is reseeded.
NEXT_PUBLIC_LIVE_COMPANY_KEY=
NEXT_PUBLIC_LIVE_COMPANY_ID=
NEXT_PUBLIC_LIVE_OWNER_ID=
NEXT_PUBLIC_LIVE_MANAGER_ID=
CONVEX_DEPLOYMENT=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
OPENAI_API_KEY=
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_SEED_CLIENT_ID=
JOBBER_SEED_CLIENT_SECRET=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
GUSTO_CLIENT_ID=
GUSTO_CLIENT_SECRET=
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
COURIER_KEY=
INGEST_KEY=
DEMO_MODE=1
