   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Approved questions go out as texts, like \"Which\njob were you on Tuesday? 1) Job 12  2) Job 15\".\nA reply of \"2\" is read by plain code. A free-\ntext reply like \"the second one\" is read by a\nquick AI reader (Haiku) inside our backend,\nnever by Creao.",
   "originalText": "Approved questions go out as texts, like \"Which\njob were you on Tuesday? 1) Job 12  2) Job 15\".\nA reply of \"2\" is read by plain code. A free-\ntext reply like \"the second one\" is read by a\nquick AI reader (Haiku) inside our backend,\nnever by Creao.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
