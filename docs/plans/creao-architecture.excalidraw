   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The owner sees the morning list, every\nopen question, and a \"working…\" badge\nwhile a Creao helper is busy. They\napprove suggestions, approve texts\nbefore they go out, and check the final\npay. Every number says where it came\nfrom.",
   "originalText": "The owner sees the morning list, every\nopen question, and a \"working…\" badge\nwhile a Creao helper is busy. They\napprove suggestions, approve texts\nbefore they go out, and check the final\npay. Every number says where it came\nfrom.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
