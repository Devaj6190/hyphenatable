   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The fixed checks and texting don't depend on Creao at\nall. If we keep the backup, the same helper\ninstructions can run inside our own backend instead.",
   "originalText": "The fixed checks and texting don't depend on Creao at\nall. If we keep the backup, the same helper\ninstructions can run inside our own backend instead.",
