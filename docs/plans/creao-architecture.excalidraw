   "versionNonce": 161042649,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Jobber (who worked, on which job, for\nhow many hours), QuickBooks (expenses)\nand Gusto (who gets paid, and at what\nrate).\n\nAt the start of each pay period our\nbackend copies these in and writes down\nhow many records it expected and how\nmany it got. If something is missing,\neverything it covers stays on hold.",
   "originalText": "Jobber (who worked, on which job, for\nhow many hours), QuickBooks (expenses)\nand Gusto (who gets paid, and at what\nrate).\n\nAt the start of each pay period our\nbackend copies these in and writes down\nhow many records it expected and how\nmany it got. If something is missing,\neverything it covers stays on hold.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
