   "versionNonce": 389609434,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A set of exact, written-down checks,\nlike \"a shift longer than 14 hours\" or\n\"hours on a job that was already\nclosed\". It also does all the pay math,\nin whole cents.\n\nIt never guesses. If a case needs\njudgment, it becomes a question for a\nperson. Same input, same answer, every\ntime.",
   "originalText": "A set of exact, written-down checks,\nlike \"a shift longer than 14 hours\" or\n\"hours on a job that was already\nclosed\". It also does all the pay math,\nin whole cents.\n\nIt never guesses. If a case needs\njudgment, it becomes a question for a\nperson. Same input, same answer, every\ntime.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
