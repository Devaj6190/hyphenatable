   "x": 2162,
   "y": 673.75,
   "width": 516,
   "height": 85.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1002170859,
   "version": 1,
   "versionNonce": 51810463,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The fixed checks, all pay math, approvals, texting, the\nGusto draft and the house-rules store all stay in our\nown code. The helpers still only suggest, and a person\nstill approves.",
   "originalText": "The fixed checks, all pay math, approvals, texting, the\nGusto draft and the house-rules store all stay in our\nown code. The helpers still only suggest, and a person\nstill approves.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
