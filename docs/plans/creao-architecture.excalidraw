   "locked": false,
   "text": "Creao: AI helpers that live on Creao's\ncomputers",
   "originalText": "Creao: AI helpers that live on Creao's\ncomputers",
   "fontSize": 26,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e13",
   "type": "text",
   "x": 1442,
   "y": 269.0,
   "width": 556,
   "height": 112.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1243862423,
   "version": 1,
   "versionNonce": 1800188483,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Before, these helpers were going to run inside our own\nbackend. Now Creao hosts each one in its own sealed\nworkspace and pays for the AI with its credits. A run\ntakes a few minutes, so they do the slow \"think it over\"\nwork, never the live part of the demo.",
   "originalText": "Before, these helpers were going to run inside our own\nbackend. Now Creao hosts each one in its own sealed\nworkspace and pays for the AI with its credits. A run\ntakes a few minutes, so they do the slow \"think it over\"\nwork, never the live part of the demo.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
