   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e10",
   "type": "text",
   "x": 702,
   "y": 236.5,
   "width": 476,
   "height": 337.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 265695474,
   "version": 1,
   "versionNonce": 1703729685,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "(Convex) This is the only place where anything\nactually changes. It keeps every record, knows\nwhich step each pay period is at, and writes\nevery action into a log that can't be edited.\n\nIt decides when to wake a Creao helper. It is\nalso the locked door the helpers have to knock\non: they show a secret key, and they only ever\nsee ids, dates, hours and check numbers. Never\nnames, phone numbers or pay amounts.\n\nEverything a helper sends back is checked and\nstored as a suggestion. Nothing becomes real\nuntil the owner approves it or a fixed rule\nallows it.",
   "originalText": "(Convex) This is the only place where anything\nactually changes. It keeps every record, knows\nwhich step each pay period is at, and writes\nevery action into a log that can't be edited.\n\nIt decides when to wake a Creao helper. It is\nalso the locked door the helpers have to knock\non: they show a secret key, and they only ever\nsee ids, dates, hours and check numbers. Never\nnames, phone numbers or pay amounts.\n\nEverything a helper sends back is checked and\nstored as a suggestion. Nothing becomes real\nuntil the owner approves it or a fixed rule\nallows it.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
