{
  "name": "@payrollpilot/connectors",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only connectors (Jobber, QuickBooks, Gusto read, exports) returning shared-context section 6 shapes with completeness SyncRuns.",
  "exports": {
    "./jobber": "./src/jobber/index.ts",
    "./qbo": "./src/qbo/index.ts",
    "./gusto": "./src/gusto/read.ts",
    "./exports/jobber-timesheets": "./src/exports/jobber-timesheets-xlsx.ts",
    "./exports/gusto-payroll-journal": "./src/exports/gusto-payroll-journal-csv.ts",
    "./exports/qbo": "./src/exports/qbo-xlsx.ts",
    "./money": "./src/money.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "jobber": "bun run src/jobber/cli.ts",
    "qbo": "bun run src/qbo/cli.ts",
    "gusto": "bun run src/gusto/cli.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "intuit-oauth": "4.2.5",
    "jszip": "3.10.2"
  }
}
